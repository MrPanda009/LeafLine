# Shared Environment Variables (Safe to commit - no secrets)
# These are non-sensitive configuration values shared across all environments

# Application Configuration
NEXT_PUBLIC_APP_NAME="Civic Complaint Portal"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Feature Flags
NEXT_PUBLIC_ENABLE_VOICE_TO_TEXT=true
NEXT_PUBLIC_MAX_PHOTOS_PER_COMPLAINT=5
NEXT_PUBLIC_MAX_PHOTO_SIZE_MB=5

# Location Settings
NEXT_PUBLIC_DUPLICATE_RADIUS_METERS=20
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=28.7041
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=77.1025
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=12

# Complaint Settings
NEXT_PUBLIC_MIN_DESCRIPTION_LENGTH=20
NEXT_PUBLIC_MAX_DESCRIPTION_LENGTH=1000

# UI Configuration
NEXT_PUBLIC_ITEMS_PER_PAGE=10
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
